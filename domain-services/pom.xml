    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>edu.northeastern.cs6510</groupId>
                <artifactId>service-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- spring-kafka is already version-managed by the Spring Boot parent. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.20.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
