# Copy to services.env (gitignored) and replace every change-me before starting the stack:
#   docker compose -f domain-services/deployment/docker-compose.yml \
#     --env-file domain-services/deployment/services.env up -d --build
# Each pair creates one owner account on that service's private MySQL instance only.
CATALOG_DB_PASSWORD=change-me
CATALOG_DB_ROOT_PASSWORD=change-me
CHECKOUT_DB_PASSWORD=change-me
CHECKOUT_DB_ROOT_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
INVENTORY_DB_ROOT_PASSWORD=change-me
ANALYTICS_DB_PASSWORD=change-me
ANALYTICS_DB_ROOT_PASSWORD=change-me

# Optional overrides (defaults shown).
# CATALOG_DB_NAME=catalog
# CATALOG_DB_USERNAME=catalog_service
# CHECKOUT_DB_NAME=checkout
# CHECKOUT_DB_USERNAME=checkout_service
# INVENTORY_DB_NAME=inventory
# INVENTORY_DB_USERNAME=inventory_service
# ANALYTICS_DB_NAME=analytics
# ANALYTICS_DB_USERNAME=analytics_service
# CHECKOUT_DB_POOL_SIZE=15
# LOW_STOCK_THRESHOLD=10
# Host-side operator ports when a default is taken (defaults 8081-8084).
# CATALOG_HOST_PORT=8081
# CHECKOUT_HOST_PORT=8082
# INVENTORY_HOST_PORT=8083
# ANALYTICS_HOST_PORT=8084
